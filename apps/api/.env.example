# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://localhost:5432/warranted

# Sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

PORT=3001

# Where the builder portal runs, for CORS.
WEB_ORIGIN=http://localhost:5173

# Claude API key for claim triage. Triage is skipped without it —
# the app still runs, claims just arrive untriaged.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Local disk path for uploaded claim photos (swap for S3 in production).
UPLOAD_DIR=./uploads
